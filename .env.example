# Cloudflare account ID — right sidebar of any zone dashboard page
R2_ACCOUNT_ID=

# R2 API token (not your global API token):
# Create one at: https://dash.cloudflare.com/<ACCOUNT_ID>/api-tokens
# Permissions: Object Read & Write on bucket "maps"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET=maps
