{
  "name": "pug-maps",
  "private": true,
  "type": "module",
  "description": "Builds the self-hosted map assets for the Pug dashboard: Protomaps basemap extract, glyph fonts, and India point-of-view boundary data. Artifacts deploy to Cloudflare R2 and are served through the Cloudflare CDN.",
  "license": "MIT",
  "scripts": {
    "fetch": "bun run src/fetch-map-assets.ts",
    "generate": "bun run src/build-india-pov-data.ts",
    "verify": "bun run src/conformance.ts",
    "build": "bun run fetch && bun run generate",
    "deploy": "bun run src/deploy.ts",
    "sync:app": "bun run src/sync-app.ts"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.3",
    "pbf": "^4.0.1",
    "pmtiles": "^4.3.0",
    "polygon-clipping": "^0.15.7",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "bun-types": "^1.3.14",
    "typescript": "^5.7.0"
  }
}
